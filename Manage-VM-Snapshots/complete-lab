Create maintenance script for cleanup:
sudo cat > /opt/vm-snapshots/maintenance.sh << 'EOF'
#!/bin/bash

# Snapshot Maintenance Script
LOG_FILE="/var/log/vm-snapshot-maintenance.log"

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | sudo tee -a "$LOG_FILE"
}

# Rotate logs
rotate_logs() {
    local log_file="$1"
    local max_size_mb="${2:-10}"
    
    if [ -f "$log_file" ]; then
        size_mb=$(du -m "$log_file" | cut -f1)
        if [ "$size_mb" -gt "$max_size_mb" ]; then
            log_message "Rotating log file: $log_file"
            sudo mv "$log_file" "${log_file}.old"
            sudo touch "$log_file"
        fi
    fi
}

# Clean up old snapshots beyond retention policy
cleanup_old_snapshots() {
    local vm_name="$1"
    local retention_days="${2:-30}"
    
    log_message "Cleaning up snapshots older than $retention_days days for VM: $vm_name"
    
    # This is a more aggressive cleanup for very old snapshots
    sudo virsh snapshot-list "$vm_name" --name | while read snapshot; do
        if [ -n "$snapshot" ] && [[ "$snapshot" == auto-* ]]; then
            # Extract date from snapshot name (format: auto-YYYYMMDD-HHMMSS)
            snapshot_date=$(echo "$snapshot" | sed 's/auto-\([0-9]\{8\}\).*/\1/')
            if [ -n "$snapshot_date" ]; then
                snapshot_epoch=$(date -d "$snapshot_date" +%s 2>/dev/null)
                current_epoch=$(date +%s)
                age_days=$(( (current_epoch - snapshot_epoch) / 86400 ))
                
                if [ "$age_days" -gt "$retention_days" ]; then
                    log_message "Deleting old snapshot: $snapshot (age: $age_days days)"
                    sudo virsh snapshot-delete "$vm_name" "$snapshot"
                fi
            fi
        fi
    done
}

log_message "Starting maintenance tasks"

# Rotate logs
rotate_logs "/var/log/vm-snapshots.log" 10
rotate_logs "/var/log/vm-snapshot-verification.log" 5
rotate_logs "/var/log/vm-snapshot-monitor.log" 5

# Cleanup old snapshots
cleanup_old_snapshots "test-vm" 30

log_message "Maintenance tasks completed"
EOF

sudo chmod +x /opt/vm-snapshots/maintenance.sh
Troubleshooting Common Issues
Issue 1: Snapshot Creation Fails
Problem: Snapshot creation fails with "operation not supported" error.

Solution:

# Check VM disk format
sudo virsh domblklist test-vm

# Ensure VM is using qcow2 format for internal snapshots
sudo qemu-img info /path/to/vm/disk.qcow2

# Convert raw disk to qcow2 if needed (VM must be shut down)
sudo qemu-img convert -f raw -O qcow2 /path/to/disk.raw /path/to/disk.qcow2
Issue 2: Snapshot Revert Fails
Problem: Cannot revert to snapshot due to VM state conflicts.

Solution:

# Force shutdown VM if needed
sudo virsh destroy test-vm

# Check snapshot state
sudo virsh snapshot-info test-vm snapshot-name

# Try revert with force option
sudo virsh snapshot-revert test-vm snapshot-name --force
Issue 3: Disk Space Issues
Problem: Snapshots consuming too much disk space.

Solution:

# Check snapshot sizes
sudo virsh domblklist test-vm | while read target source; do
    if [ "$target" != "Target" ] && [ -n "$source" ]; then
        echo "$target: $(du -sh $source)"
    fi
done

# Merge snapshots to reduce space (careful - this is destructive)
sudo virsh blockcommit test-vm vda --active --verbose --pivot
