#!/bin/bash

# Snapshot Verification Script
VM_NAME="$1"
LOG_FILE="/var/log/vm-snapshot-verification.log"

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | sudo tee -a "$LOG_FILE"
}

if [ -z "$VM_NAME" ]; then
    echo "Usage: $0 <vm-name>"
    exit 1
