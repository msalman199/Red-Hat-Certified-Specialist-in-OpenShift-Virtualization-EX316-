Task 3: Automate Snapshot Creation via Scheduled Tasks
Subtask 3.1: Create Automated Snapshot Scripts
Let's create comprehensive scripts for automated snapshot management.

Create main snapshot automation script:
sudo mkdir -p /opt/vm-snapshots
sudo cat > /opt/vm-snapshots/auto-snapshot.sh << 'EOF'
#!/bin/bash

# VM Snapshot Automation Script
# Usage: auto-snapshot.sh <vm-name> [retention-days]

VM_NAME="$1"
RETENTION_DAYS="${2:-7}"
LOG_FILE="/var/log/vm-snapshots.log"
SNAPSHOT_PREFIX="auto"

# Logging function
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | sudo tee -a "$LOG_FILE"
}

# Validate input
if [ -z "$VM_NAME" ]; then
    log_message "ERROR: VM name not provided"
    echo "Usage: $0 <vm-name> [retention-days]"
    exit 1
fi

# Check if VM exists
if ! sudo virsh list --all | grep -q "$VM_NAME"; then
    log_message "ERROR: VM '$VM_NAME' not found"
    exit 1
fi

# Generate snapshot name with timestamp
SNAPSHOT_NAME="${SNAPSHOT_PREFIX}-$(date +%Y%m%d-%H%M%S)"

log_message "Starting automated snapshot for VM: $VM_NAME"

# Create snapshot
if sudo virsh snapshot-create-as "$VM_NAME" \
    --name "$SNAPSHOT_NAME" \
    --description "Automated snapshot created on $(date)" \
    --atomic; then
    log_message "SUCCESS: Snapshot '$SNAPSHOT_NAME' created for VM '$VM_NAME'"
else
    log_message "ERROR: Failed to create snapshot for VM '$VM_NAME'"
    exit 1
fi

# Cleanup old snapshots
log_message "Cleaning up snapshots older than $RETENTION_DAYS days"

# Get list of automated snapshots
OLD_SNAPSHOTS=$(sudo virsh snapshot-list "$VM_NAME" --name | grep "^${SNAPSHOT_PREFIX}-" | head -n -"$RETENTION_DAYS")

for snapshot in $OLD_SNAPSHOTS; do
    if [ -n "$snapshot" ]; then
        if sudo virsh snapshot-delete "$VM_NAME" "$snapshot"; then
            log_message "SUCCESS: Deleted old snapshot '$snapshot'"
        else
            log_message "ERROR: Failed to delete snapshot '$snapshot'"
        fi
    fi
done

log_message "Automated snapshot process completed for VM: $VM_NAME"
EOF

sudo chmod +x /opt/vm-snapshots/auto-snapshot.sh
Create snapshot management utility:
sudo cat > /opt/vm-snapshots/snapshot-manager.sh << 'EOF'
#!/bin/bash

# VM Snapshot Manager
# Provides various snapshot management functions

SCRIPT_DIR="/opt/vm-snapshots"
LOG_FILE="/var/log/vm-snapshots.log"

show_usage() {
    echo "VM Snapshot Manager"
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  list <vm-name>              - List all snapshots for VM"
    echo "  create <vm-name> [name]     - Create snapshot"
    echo "  delete <vm-name> <snapshot> - Delete specific snapshot"
    echo "  revert <vm-name> <snapshot> - Revert to snapshot"
    echo "  cleanup <vm-name> [days]    - Cleanup old snapshots"
    echo "  status <vm-name>            - Show VM and snapshot status"
}

list_snapshots() {
    local vm_name="$1"
    echo "=== Snapshots for VM: $vm_name ==="
    sudo virsh snapshot-list "$vm_name" --tree
    echo ""
    echo "=== Snapshot Details ==="
    sudo virsh snapshot-list "$vm_name" --name | while read snapshot; do
        if [ -n "$snapshot" ]; then
            echo "Snapshot: $snapshot"
            sudo virsh snapshot-info "$vm_name" "$snapshot" | grep -E "(Creation Time|Description)"
            echo "---"
        fi
    done
}

create_snapshot() {
    local vm_name="$1"
    local snapshot_name="${2:-manual-$(date +%Y%m%d-%H%M%S)}"
    
    echo "Creating snapshot '$snapshot_name' for VM '$vm_name'..."
    if sudo virsh snapshot-create-as "$vm_name" \
        --name "$snapshot_name" \
        --description "Manual snapshot created on $(date)" \
        --atomic; then
        echo "SUCCESS: Snapshot created"
    else
        echo "ERROR: Failed to create snapshot"
        return 1
    fi
}

delete_snapshot() {
    local vm_name="$1"
    local snapshot_name="$2"
    
    if [ -z "$snapshot_name" ]; then
        echo "ERROR: Snapshot name required"
        return 1
    fi
    
    echo "Deleting snapshot '$snapshot_name' from VM '$vm_name'..."
    if sudo virsh snapshot-delete "$vm_name" "$snapshot_name"; then
        echo "SUCCESS: Snapshot deleted"
    else
        echo "ERROR: Failed to delete snapshot"
        return 1
    fi
}

revert_snapshot() {
    local vm_name="$1"
    local snapshot_name="$2"
    
    if [ -z "$snapshot_name" ]; then
        echo "ERROR: Snapshot name required"
        return 1
    fi
    
    echo "Reverting VM '$vm_name' to snapshot '$snapshot_name'..."
    
    # Check if VM is running
    if sudo virsh list --state-running | grep -q "$vm_name"; then
        echo "Shutting down VM..."
        sudo virsh shutdown "$vm_name"
        sleep 10
    fi
    
    if sudo virsh snapshot-revert "$vm_name" "$snapshot_name"; then
        echo "SUCCESS: Reverted to snapshot"
        echo "Starting VM..."
        sudo virsh start "$vm_name"
    else
        echo "ERROR: Failed to revert snapshot"
        return 1
    fi
}

show_status() {
    local vm_name="$1"
    
    echo "=== VM Status ==="
    sudo virsh list --all | grep "$vm_name"
    echo ""
    echo "=== Current Snapshot ==="
    sudo virsh snapshot-current "$vm_name" --name 2>/dev/null || echo "No current snapshot"
    echo ""
    echo "=== Snapshot Count ==="
    echo "Total snapshots: $(sudo virsh snapshot-list "$vm_name" --name | wc -l)"
}

# Main command processing
case "$1" in
    list)
        list_snapshots "$2"
        ;;
    create)
        create_snapshot "$2" "$3"
        ;;
    delete)
        delete_snapshot "$2" "$3"
        ;;
    revert)
        revert_snapshot "$2" "$3"
        ;;
    status)
        show_status "$2"
        ;;
    cleanup)
        "$SCRIPT_DIR/auto-snapshot.sh" "$2" "${3:-7}"
        ;;
    *)
        show_usage
        exit 1
        ;;
esac
EOF

sudo chmod +x /opt/vm-snapshots/snapshot-manager.sh
Subtask 3.2: Configure Scheduled Snapshot Tasks
Now let's set up automated scheduling using systemd timers and cron jobs.

Create systemd service for snapshot automation:
sudo cat > /etc/systemd/system/vm-snapshot@.service << 'EOF'
[Unit]
Description=VM Snapshot Service for %i
After=libvirtd.service

[Service]
Type=oneshot
ExecStart=/opt/vm-snapshots/auto-snapshot.sh %i 7
User=root
StandardOutput=journal
StandardError=journal
EOF
Create systemd timer for regular snapshots:
sudo cat > /etc/systemd/system/vm-snapshot@.timer << 'EOF'
[Unit]
Description=VM Snapshot Timer for %i
Requires=vm-snapshot@%i.service

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
