# Check snapshot integrity
SNAPSHOT_COUNT=$(sudo virsh snapshot-list "$VM_NAME" --name | wc -l)
log_message "Found $SNAPSHOT_COUNT snapshots"

if [ "$SNAPSHOT_COUNT" -eq 0 ]; then
    log_message "WARNING: No snapshots found for VM $VM_NAME"
    exit 1
fi

# Verify recent snapshots
RECENT_SNAPSHOTS=$(sudo virsh snapshot-list "$VM_NAME" --name | head -5)

for snapshot in $RECENT_SNAPSHOTS; do
    if [ -n "$snapshot" ]; then
        # Check snapshot metadata
        if sudo virsh snapshot-info "$VM_NAME" "$snapshot" >/dev/null 2>&1; then
            log_message "SUCCESS: Snapshot '$snapshot' is valid"
        else
            log_message "ERROR: Snapshot '$snapshot' appears corrupted"
        fi
    fi
done

# Check disk space usage
SNAPSHOT_SIZE=$(sudo virsh domblklist "$VM_NAME" | grep -v "^Target" | awk '{print $2}' | xargs -I {} du -sh {} 2>/dev/null | awk '{sum+=$1} END {print sum}')
