Subtask 4.3: Validate Node Drain Completion
Verify node is fully drained:
# Check node drain status
check_drain_status() {
    local node=$1
    
    echo "Drain Status Check for Node: $node"
    echo "=================================="
    
    # Check if node is unschedulable
    UNSCHEDULABLE=$(oc get node $node -o jsonpath='{.spec.unschedulable}')
    echo "Node unschedulable: $UNSCHEDULABLE"
    
    # Check for NoSchedule taint
    TAINT=$(oc get node $node -o jsonpath='{.spec.taints[?@.effect=="NoSchedule"].key}')
    echo "NoSchedule taint: $TAINT"
    
    # Count remaining workloads
    PODS=$(oc get pods -A --field-selector spec.nodeName=$node --no-headers 2>/dev/null | grep -v "DaemonSet" | wc -l)
    VMS=$(oc get vmi -A --field-selector spec.nodeName=$node --no-headers 2>/dev/null | wc -l)
    
    echo "Remaining pods (non-DaemonSet): $PODS"
    echo "Remaining VMs: $VMS"
    
    if [ "$UNSCHEDULABLE" = "true" ] && [ "$PODS" -eq 0 ] && [ "$VMS" -eq 0 ]; then
        echo "✅ Node successfully drained and ready for maintenance"
        return 0
    else
        echo "❌ Node drain incomplete"
        return 1
    fi
}

# Check drain status
check_drain_status $MAINTENANCE_NODE
