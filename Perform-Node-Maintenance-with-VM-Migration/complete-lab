Troubleshooting Common Issues
Issue 1: VMs Not Migrating During Drain
Symptoms: VMs remain on the node being drained

Solutions:

# Check if live migration is enabled
oc get kubevirt -n openshift-cnv -o yaml | grep -A 5 -B 5 migration

# Verify migration policies
oc get migrationpolicy -A

# Check node resources on target nodes
oc describe nodes | grep -A 5 "Allocated resources"

# Manually trigger migration if needed
oc patch vm <vm-name> -n <namespace> --type merge -p '{"spec":{"runStrategy":"RerunOnFailure"}}'
Issue 2: Node Drain Hangs or Times Out
Symptoms: Drain command doesn't complete within timeout period

Solutions:

# Increase timeout and use force options
oc adm drain $MAINTENANCE_NODE \
  --ignore-daemonsets \
  --delete-emptydir-data \
  --force \
  --timeout=1200s \
  --grace-period=300

# Check for pods with finalizers
oc get pods -A --field-selector spec.nodeName=$MAINTENANCE_NODE -o yaml | grep finalizers

# Force delete stuck pods if necessary (use with caution)
oc delete pod <stuck-pod> -n <namespace> --force --grace-period=0
Issue 3: VM Migration Fails
Symptoms: VirtualMachineInstanceMigration shows failed status

Solutions:

# Check migration object details
oc describe vmim <migration-name> -n <namespace>

# Verify target node resources
oc describe node <target-node> | grep -A 10 "Allocated resources"

# Check VM resource requirements
oc get vm <vm-name> -n <namespace> -o yaml | grep -A 10 resources

# Restart VM if migration consistently fails
oc patch vm <vm-name> -n <namespace> --type merge -p '{"spec":{"running":false}}'
sleep 30
oc patch vm <vm-name> -n <namespace> --type merge -p '{"spec":{"running":true}}'
