# Main monitoring loop
while true; do
    show_header
    show_node_status
    show_vm_status
    show_migration_status
    show_pod_status
    
    echo "Press Ctrl+C to exit monitoring"
    echo "Next update in 30 seconds..."
    sleep 30
done
EOF

