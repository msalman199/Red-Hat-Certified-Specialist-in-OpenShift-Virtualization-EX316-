Task 3: Automate Cloning Using Scripts
Subtask 3.1: Create Basic Cloning Script
Develop a shell script to automate the VM cloning process.

Create the main cloning script:
# Create script directory
sudo mkdir -p /opt/vm-automation

# Create the cloning script
sudo cat > /opt/vm-automation/clone-vm.sh << 'EOF'
#!/bin/bash

# VM Cloning Automation Script
# Usage: ./clone-vm.sh <source-vm> <clone-name> <clone-type>

set -e

# Function to display usage
usage() {
    echo "Usage: $0 <source-vm> <clone-name> <clone-type>"
    echo "Clone types: full, linked"
    echo "Example: $0 template-vm web-server-01 full"
    exit 1
}

# Function to log messages
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

# Check arguments
if [ $# -ne 3 ]; then
    usage
fi

SOURCE_VM="$1"
CLONE_NAME="$2"
CLONE_TYPE="$3"
IMAGES_DIR="/var/lib/libvirt/images"

# Validate clone type
if [[ "$CLONE_TYPE" != "full" && "$CLONE_TYPE" != "linked" ]]; then
    echo "Error: Clone type must be 'full' or 'linked'"
    usage
fi

# Check if source VM exists
if ! virsh list --all | grep -q "$SOURCE_VM"; then
    echo "Error: Source VM '$SOURCE_VM' not found"
    exit 1
fi

# Check if clone name already exists
if virsh list --all | grep -q "$CLONE_NAME"; then
    echo "Error: VM '$CLONE_NAME' already exists"
    exit 1
fi

log "Starting $CLONE_TYPE clone of $SOURCE_VM to $CLONE_NAME"

# Ensure source VM is shutdown
VM_STATE=$(virsh domstate "$SOURCE_VM")
if [ "$VM_STATE" = "running" ]; then
    log "Shutting down source VM $SOURCE_VM"
    virsh shutdown "$SOURCE_VM"
    
    # Wait for shutdown
    while [ "$(virsh domstate "$SOURCE_VM")" = "running" ]; do
        sleep 2
    done
    log "Source VM shutdown complete"
fi

# Perform cloning based on type
if [ "$CLONE_TYPE" = "full" ]; then
    log "Creating full clone..."
    virt-clone \
        --original "$SOURCE_VM" \
        --name "$CLONE_NAME" \
        --file "$IMAGES_DIR/${CLONE_NAME}.qcow2"
    
elif [ "$CLONE_TYPE" = "linked" ]; then
    log "Creating linked clone..."
    
    # Create backing file
    qemu-img create -f qcow2 \
        -b "$IMAGES_DIR/${SOURCE_VM}.qcow2" \
        "$IMAGES_DIR/${CLONE_NAME}.qcow2"
    
    # Export and modify VM configuration
    virsh dumpxml "$SOURCE_VM" > "/tmp/${CLONE_NAME}.xml"
    
    # Replace VM name and disk path
    sed -i "s/<name>$SOURCE_VM<\/name>/<name>$CLONE_NAME<\/name>/" "/tmp/${CLONE_NAME}.xml"
    sed -i "s/${SOURCE_VM}.qcow2/${CLONE_NAME}.qcow2/g" "/tmp/${CLONE_NAME}.xml"
    
    # Generate new UUID
    NEW_UUID=$(uuidgen)
    sed -i "s/<uuid>.*<\/uuid>/<uuid>$NEW_UUID<\/uuid>/" "/tmp/${CLONE_NAME}.xml"
    
    # Remove MAC address to auto-generate new one
    sed -i "/<mac address=/d" "/tmp/${CLONE_NAME}.xml"
    
    # Define the new VM
    virsh define "/tmp/${CLONE_NAME}.xml"
    rm "/tmp/${CLONE_NAME}.xml"
fi

log "Clone $CLONE_NAME created successfully"
log "Use 'virsh start $CLONE_NAME' to start the cloned VM"
EOF

# Make script executable
sudo chmod +x /opt/vm-automation/clone-vm.sh
Subtask 3.2: Create Advanced Cloning Script with Configuration
Develop a more sophisticated script that includes post-clone configuration.

Create advanced cloning script:
# Create advanced cloning script
sudo cat > /opt/vm-automation/advanced-clone.sh << 'EOF'
#!/bin/bash

# Advanced VM Cloning Script with Configuration
# Usage: ./advanced-clone.sh <config-file>

set -e

# Function to log messages
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

# Function to validate configuration
validate_config() {
    local config_file="$1"
    
    if [ ! -f "$config_file" ]; then
        echo "Error: Configuration file '$config_file' not found"
        exit 1
    fi
    
    # Source the configuration
    source "$config_file"
    
    # Validate required variables
    if [ -z "$SOURCE_VM" ] || [ -z "$CLONE_NAME" ] || [ -z "$CLONE_TYPE" ]; then
        echo "Error: Missing required configuration variables"
        echo "Required: SOURCE_VM, CLONE_NAME, CLONE_TYPE"
        exit 1
    fi
}

# Function to modify VM resources
modify_vm_resources() {
    local vm_name="$1"
    
    if [ -n "$MEMORY_MB" ]; then
        log "Setting memory to ${MEMORY_MB}MB"
        virsh setmaxmem "$vm_name" "${MEMORY_MB}M" --config
        virsh setmem "$vm_name" "${MEMORY_MB}M" --config
    fi
    
    if [ -n "$VCPUS" ]; then
        log "Setting vCPUs to $VCPUS"
        virsh setvcpus "$vm_name" "$VCPUS" --config --maximum
        virsh setvcpus "$vm_name" "$VCPUS" --config
    fi
}

# Function to add additional storage
add_storage() {
    local vm_name="$1"
    
    if [ -n "$ADDITIONAL_DISK_SIZE" ]; then
        log "Adding additional disk of ${ADDITIONAL_DISK_SIZE}GB"
        
        local disk_path="/var/lib/libvirt/images/${vm_name}-data.qcow2"
        qemu-img create -f qcow2 "$disk_path" "${ADDITIONAL_DISK_SIZE}G"
        
        # Attach disk to VM
        virsh attach-disk "$vm_name" "$disk_path" vdb \
            --driver qemu --subdriver qcow2 --config
    fi
}

# Function to configure network
configure_network() {
    local vm_name="$1"
    
    if [ -n "$NETWORK_NAME" ]; then
        log "Configuring network: $NETWORK_NAME"
        
        # Get current network interface
        local mac_line=$(virsh dumpxml "$vm_name" | grep -A1 "interface type='network'" | grep "mac address")
        
        if [ -n "$mac_line" ]; then
            # Update network source
            virsh detach-interface "$vm_name" network --config
            virsh attach-interface "$vm_name" network "$NETWORK_NAME" --config
        fi
    fi
}

# Function to create cloud-init configuration
create_cloud_init() {
    local vm_name="$1"
    
    if [ "$ENABLE_CLOUD_INIT" = "true" ]; then
        log "Creating cloud-init configuration"
        
        local cloud_init_dir="/var/lib/libvirt/images/cloud-init/$vm_name"
        mkdir -p "$cloud_init_dir"
        
        # Create user-data
        cat > "$cloud_init_dir/user-data" << CLOUD_EOF
#cloud-config
hostname: $vm_name
users:
  - name: ${CLOUD_USER:-admin}
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${SSH_PUBLIC_KEY:-}
packages:
  - ${PACKAGES:-curl wget vim}
runcmd:
  - ${POST_INSTALL_COMMANDS:-echo "No post-install commands"}
CLOUD_EOF
        
        # Create meta-data
        cat > "$cloud_init_dir/meta-data" << CLOUD_EOF
instance-id: $vm_name
local-hostname: $vm_name
CLOUD_EOF
        
        # Create ISO
        genisoimage -output "/var/lib/libvirt/images/${vm_name}-cloud-init.iso" \
            -volid cidata -joliet -rock \
            "$cloud_init_dir/user-data" \
            "$cloud_init_dir/meta-data"
        
        # Attach ISO to VM
        virsh attach-disk "$vm_name" \
            "/var/lib/libvirt/images/${vm_name}-cloud-init.iso" \
            hda --type cdrom --config
    fi
}

# Main execution
main() {
    local config_file="$1"
    
    if [ $# -ne 1 ]; then
        echo "Usage: $0 <config-file>"
        exit 1
    fi
    
    validate_config "$config_file"
    
    log "Starting advanced cloning process"
    log "Source VM: $SOURCE_VM"
    log "Clone Name: $CLONE_NAME"
    log "Clone Type: $CLONE_TYPE"
    
    # Perform basic cloning
    /opt/vm-automation/clone-vm.sh "$SOURCE_VM" "$CLONE_NAME" "$CLONE_TYPE"
    
    # Apply advanced configurations
    modify_vm_resources "$CLONE_NAME"
    add_storage "$CLONE_NAME"
    configure_network "$CLONE_NAME"
    create_cloud_init "$CLONE_NAME"
    
    log "Advanced cloning completed successfully"
    
    if [ "$AUTO_START" = "true" ]; then
        log "Starting VM $CLONE_NAME"
        virsh start "$CLONE_NAME"
    fi
}

main "$@"
EOF

# Make script executable
sudo chmod +x /opt/vm-automation/advanced-clone.sh
