Task 1: Automate VM Creation, Scaling, and Deletion
Subtask 1.1: Set Up the Automation Environment
# Create directory structure for VM automation
mkdir -p ~/vm-automation/{scripts,logs,backups,config}
cd ~/vm-automation

# Create configuration file for default values
cat > config/vm-defaults.conf << 'EOF'
# Default VM Configuration
DEFAULT_NAMESPACE="vm-automation"
DEFAULT_CPU_CORES="2"
DEFAULT_MEMORY="4Gi"
LOG_DIR="$HOME/vm-automation/logs"
BACKUP_DIR="$HOME/vm-automation/backups"
EOF

source config/vm-defaults.conf

# Create the working namespace
oc create namespace vm-automation --dry-run=client -o yaml | oc apply -f -
Deliverable: running cat ~/vm-automation/config/vm-defaults.conf shows the four configuration variables, and oc get namespace vm-automation shows the namespace in Active status.

Subtask 1.2: Create the VM Creation Script
cat > scripts/create-vm.sh << 'EOF'
#!/bin/bash

# VM Creation Automation Script
# Usage: ./create-vm.sh <vm-name> [cpu-cores] [memory] [namespace]

set -e

source "$(dirname "$0")/../config/vm-defaults.conf"

log_message() {
    mkdir -p "$LOG_DIR"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_DIR/vm-creation.log"
}

validate_input() {
    if [[ -z "$1" ]]; then
        echo "Error: VM name is required"
        echo "Usage: $0 <vm-name> [cpu-cores] [memory] [namespace]"
        exit 1
    fi
}

check_vm_exists() {
    local vm_name=$1
    local namespace=$2

    if oc get vm "$vm_name" -n "$namespace" &>/dev/null; then
        log_message "ERROR: VM $vm_name already exists in namespace $namespace"
        exit 1
    fi
}

create_vm() {
    local vm_name=$1
    local cpu_cores=$2
    local memory=$3
    local namespace=$4

    log_message "Creating VM: $vm_name with $cpu_cores CPU, $memory memory"

    oc create namespace "$namespace" --dry-run=client -o yaml | oc apply -f - >/dev/null

    cat > "/tmp/${vm_name}-vm.yaml" << VMEOF
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: $vm_name
  namespace: $namespace
  labels:
    app: automated-vm
    created-by: automation-script
spec:
  running: false
  template:
    metadata:
      labels:
        kubevirt.io/vm: $vm_name
    spec:
      domain:
        cpu:
          cores: $cpu_cores
        resources:
          requests:
            memory: $memory
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
      networks:
      - name: default
        pod: {}
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/fedora-cloud-container-disk-demo
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            ssh_pwauth: True
VMEOF

    oc apply -f "/tmp/${vm_name}-vm.yaml"
    rm "/tmp/${vm_name}-vm.yaml"

    log_message "VM $vm_name created successfully in namespace $namespace"
}

start_vm() {
    local vm_name=$1
    local namespace=$2

    log_message "Starting VM: $vm_name"
    oc patch vm "$vm_name" -n "$namespace" --type merge -p '{"spec":{"running":true}}'

    log_message "Waiting for VM to be ready..."
    oc wait --for=condition=Ready vmi "$vm_name" -n "$namespace" --timeout=300s

    log_message "VM $vm_name is now running"
}

main() {
    VM_NAME=$1
    CPU_CORES=${2:-$DEFAULT_CPU_CORES}
    MEMORY=${3:-$DEFAULT_MEMORY}
    NAMESPACE=${4:-$DEFAULT_NAMESPACE}

    validate_input "$VM_NAME"

    log_message "Starting VM creation process for $VM_NAME"

    check_vm_exists "$VM_NAME" "$NAMESPACE"
    create_vm "$VM_NAME" "$CPU_CORES" "$MEMORY" "$NAMESPACE"
    start_vm "$VM_NAME" "$NAMESPACE"

    log_message "VM creation process completed successfully"
}

main "$@"
EOF

chmod +x scripts/create-vm.sh
Subtask 1.3: Create the VM Scaling and Deletion Scripts
cat > scripts/scale-vm.sh << 'EOF'
#!/bin/bash

# VM Scaling Automation Script
# Usage: ./scale-vm.sh <vm-name> [--cpu <cores>] [--memory <size>] [--namespace <ns>]

set -e

source "$(dirname "$0")/../config/vm-defaults.conf"

log_message() {
    mkdir -p "$LOG_DIR"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_DIR/vm-scaling.log"
}

validate_input() {
    if [[ -z "$1" ]]; then
        echo "Error: VM name is required"
        echo "Usage: $0 <vm-name> [--cpu <cores>] [--memory <size>] [--namespace <ns>]"
        exit 1
    fi
}

check_vm_exists() {
    local vm_name=$1
    local namespace=$2
    if ! oc get vm "$vm_name" -n "$namespace" &>/dev/null; then
        log_message "ERROR: VM $vm_name does not exist in namespace $namespace"
        exit 1
    fi
}

is_vm_running() {
    local vm_name=$1
    local namespace=$2
    oc get vmi "$vm_name" -n "$namespace" &>/dev/null
}

scale_cpu() {
    local vm_name=$1
    local namespace=$2
    local new_cpu=$3
    log_message "Scaling CPU to $new_cpu cores"
    oc patch vm "$vm_name" -n "$namespace" --type merge \
        -p "{\"spec\":{\"template\":{\"spec\":{\"domain\":{\"cpu\":{\"cores\":$new_cpu}}}}}}"
}

scale_memory() {
    local vm_name=$1
    local namespace=$2
    local new_memory=$3
    log_message "Scaling memory to $new_memory"
    oc patch vm "$vm_name" -n "$namespace" --type merge \
        -p "{\"spec\":{\"template\":{\"spec\":{\"domain\":{\"resources\":{\"requests\":{\"memory\":\"$new_memory\"}}}}}}}"
}

restart_vm_if_running() {
    local vm_name=$1
    local namespace=$2

    if is_vm_running "$vm_name" "$namespace"; then
        log_message "VM is running. Restarting to apply changes..."
        oc patch vm "$vm_name" -n "$namespace" --type merge -p '{"spec":{"running":false}}'
        while oc get vmi "$vm_name" -n "$namespace" &>/dev/null; do
            sleep 5
        done
        oc patch vm "$vm_name" -n "$namespace" --type merge -p '{"spec":{"running":true}}'
        oc wait --for=condition=Ready vmi "$vm_name" -n "$namespace" --timeout=300s
        log_message "VM restarted successfully"
    else
        log_message "VM is not running. Changes will take effect on next start."
    fi
}

main() {
    VM_NAME=$1
    NAMESPACE=$DEFAULT_NAMESPACE
    NEW_CPU=""
    NEW_MEMORY=""

    validate_input "$VM_NAME"
    shift

    while [[ $# -gt 0 ]]; do
        case $1 in
            --cpu) NEW_CPU=$2; shift 2 ;;
            --memory) NEW_MEMORY=$2; shift 2 ;;
            --namespace) NAMESPACE=$2; shift 2 ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    if [[ -z "$NEW_CPU" && -z "$NEW_MEMORY" ]]; then
        echo "Error: At least one scaling option (--cpu or --memory) must be provided"
        exit 1
    fi

    log_message "Starting VM scaling process for $VM_NAME"
    check_vm_exists "$VM_NAME" "$NAMESPACE"

    [[ -n "$NEW_CPU" ]] && scale_cpu "$VM_NAME" "$NAMESPACE" "$NEW_CPU"
    [[ -n "$NEW_MEMORY" ]] && scale_memory "$VM_NAME" "$NAMESPACE" "$NEW_MEMORY"

    restart_vm_if_running "$VM_NAME" "$NAMESPACE"

    log_message "VM scaling process completed successfully"
}

main "$@"
EOF

chmod +x scripts/scale-vm.sh

cat > scripts/delete-vm.sh << 'EOF'
#!/bin/bash

# VM Deletion Automation Script
# Usage: ./delete-vm.sh <vm-name> [namespace] [--force]

set -e

source "$(dirname "$0")/../config/vm-defaults.conf"

log_message() {
    mkdir -p "$LOG_DIR"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_DIR/vm-deletion.log"
}

validate_input() {
    if [[ -z "$1" ]]; then
        echo "Error: VM name is required"
        echo "Usage: $0 <vm-name> [namespace] [--force]"
        exit 1
    fi
}

check_vm_exists() {
    local vm_name=$1
    local namespace=$2
    if ! oc get vm "$vm_name" -n "$namespace" &>/dev/null; then
        log_message "ERROR: VM $vm_name does not exist in namespace $namespace"
        exit 1
    fi
}

stop_vm() {
    local vm_name=$1
    local namespace=$2

    if oc get vmi "$vm_name" -n "$namespace" &>/dev/null; then
        log_message "Stopping VM: $vm_name"
        oc patch vm "$vm_name" -n "$namespace" --type merge -p '{"spec":{"running":false}}'
        while oc get vmi "$vm_name" -n "$namespace" &>/dev/null; do
            sleep 5
        done
        log_message "VM stopped successfully"
    else
        log_message "VM is not running"
    fi
}

delete_vm() {
    local vm_name=$1
    local namespace=$2
    log_message "Deleting VM: $vm_name"
    oc delete vm "$vm_name" -n "$namespace"
    log_message "VM $vm_name deleted successfully"
}

confirm_deletion() {
    local vm_name=$1
    local force=$2

    if [[ "$force" != "true" ]]; then
        echo -n "Are you sure you want to delete VM $vm_name? (y/N): "
        read -r confirmation
        if [[ "$confirmation" != "y" && "$confirmation" != "Y" ]]; then
            log_message "Deletion cancelled by user"
            exit 0
        fi
    fi
}

main() {
    VM_NAME=$1
    NAMESPACE=${2:-$DEFAULT_NAMESPACE}
    FORCE=false

    shift 2 2>/dev/null || shift $#
    while [[ $# -gt 0 ]]; do
        case $1 in
            --force) FORCE=true; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    validate_input "$VM_NAME"

    log_message "Starting VM deletion process for $VM_NAME"
    check_vm_exists "$VM_NAME" "$NAMESPACE"
    confirm_deletion "$VM_NAME" "$FORCE"
    stop_vm "$VM_NAME" "$NAMESPACE"
    delete_vm "$VM_NAME" "$NAMESPACE"

    log_message "VM deletion process completed successfully"
}

main "$@"
EOF

chmod +x scripts/delete-vm.sh
