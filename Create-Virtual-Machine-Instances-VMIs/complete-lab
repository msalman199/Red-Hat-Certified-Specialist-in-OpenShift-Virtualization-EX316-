Subtask 4.4: Advanced Monitoring and Troubleshooting
Create Monitoring Script
Create a file named monitor-vmis.sh:

#!/bin/bash

echo "=== VMI Status Overview ==="
oc get vmi -o custom-columns=NAME:.metadata.name,STATUS:.status.phase,NODE:.status.nodeName,IP:.status.interfaces[0].ipAddress

echo -e "\n=== VMI Resource Usage ==="
for vmi in $(oc get vmi -o jsonpath='{.items[*].metadata.name}'); do
    echo "VMI: $vmi"
    pod=$(oc get pods -l kubevirt.io/created-by=$vmi -o jsonpath='{.items[0].metadata.name}')
    if [ ! -z "$pod" ]; then
        oc top pod $pod 2>/dev/null || echo "  Resource metrics not available"
    fi
    echo ""
done

echo "=== Recent VMI Events ==="
oc get events --field-selector involvedObject.kind=VirtualMachineInstance --sort-by='.lastTimestamp' | tail -10
Make Script Executable and Run
chmod +x monitor-vmis.sh
./monitor-vmis.sh
Create VMI Health Check
Create a file named vmi-health-check.yaml:

apiVersion: v1
kind: ConfigMap
metadata:
  name: vmi-health-check
  namespace: vmi-lab
data:
  health-check.sh: |
    #!/bin/bash
    
    check_vmi_health() {
        local vmi_name=$1
        echo "Checking health of VMI: $vmi_name"
        
        # Check VMI status
        status=$(oc get vmi $vmi_name -o jsonpath='{.status.phase}' 2>/dev/null)
        if [ "$status" = "Running" ]; then
            echo "  ✓ VMI is running"
        else
            echo "  ✗ VMI status: $status"
            return 1
        fi
        
        # Check associated pod
        pod=$(oc get pods -l kubevirt.io/created-by=$vmi_name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
        if [ ! -z "$pod" ]; then
            pod_status=$(oc get pod $pod -o jsonpath='{.status.phase}')
            echo "  ✓ Associated pod ($pod) status: $pod_status"
        else
            echo "  ✗ No associated pod found"
            return 1
        fi
        
        return 0
    }
    
    # Check all VMIs
    for vmi in $(oc get vmi -o jsonpath='{.items[*].metadata.name}'); do
        check_vmi_health $vmi
        echo ""
    done
Apply Health Check ConfigMap
oc apply -f vmi-health-check.yaml
