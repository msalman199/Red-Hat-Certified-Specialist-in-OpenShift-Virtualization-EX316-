Task 2: Create PersistentVolumeClaims (PVCs) for VMs
Subtask 2.1: Create a Basic PVC for VM Root Disk
Create a PVC that will serve as the root disk for a virtual machine.

# Create file: vm-root-disk-pvc.yaml
cat << 'EOF' > vm-root-disk-pvc.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vm-root-disk
  namespace: vm-storage-lab
  labels:
    app: vm-storage-lab
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Block
  resources:
    requests:
      storage: 20Gi
  storageClassName: ocs-storagecluster-ceph-rbd
EOF
Apply the PVC configuration:

# Create the PVC
oc apply -f vm-root-disk-pvc.yaml

# Verify PVC creation
oc get pvc vm-root-disk

# Check PVC status and details
oc describe pvc vm-root-disk
Subtask 2.2: Create a Data Disk PVC
Create an additional PVC for data storage that will persist across VM reboots.

# Create file: vm-data-disk-pvc.yaml
cat << 'EOF' > vm-data-disk-pvc.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vm-data-disk
  namespace: vm-storage-lab
  labels:
    app: vm-storage-lab
    disk-type: data
spec:
  accessModes:
    - ReadWriteOnce
  volumeMode: Block
  resources:
    requests:
      storage: 50Gi
  storageClassName: ocs-storagecluster-ceph-rbd
EOF
Apply the data disk PVC:

# Create the data disk PVC
oc apply -f vm-data-disk-pvc.yaml

# Verify both PVCs are created
oc get pvc

# Check the status of all PVCs
oc get pvc -o wide
Subtask 2.3: Create a Shared Storage PVC
Create a PVC with ReadWriteMany access mode for shared storage scenarios.

# Create file: vm-shared-storage-pvc.yaml
cat << 'EOF' > vm-shared-storage-pvc.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vm-shared-storage
  namespace: vm-storage-lab
  labels:
    app: vm-storage-lab
    disk-type: shared
spec:
  accessModes:
    - ReadWriteMany
  volumeMode: Filesystem
  resources:
    requests:
      storage: 30Gi
  storageClassName: ocs-storagecluster-cephfs
EOF
Apply the shared storage PVC:

# Create the shared storage PVC
oc apply -f vm-shared-storage-pvc.yaml

# Verify all PVCs
oc get pvc
Task 3: Attach PVCs to Virtual Machines
Subtask 3.1: Create a Virtual Machine with Root Disk PVC
Create a virtual machine that uses the root disk PVC we created earlier.

# Create file: vm-with-persistent-storage.yaml
cat << 'EOF' > vm-with-persistent-storage.yaml
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: centos-vm-persistent
  namespace: vm-storage-lab
  labels:
    app: centos-vm
spec:
  running: false
  template:
    metadata:
      labels:
        kubevirt.io/vm: centos-vm-persistent
    spec:
      domain:
        cpu:
          cores: 2
        memory:
          guest: 4Gi
        devices:
          disks:
            - name: rootdisk
              disk:
                bus: virtio
            - name: datadisk
              disk:
                bus: virtio
            - name: cloudinitdisk
              disk:
                bus: virtio
          interfaces:
            - name: default
              masquerade: {}
        resources:
          requests:
            memory: 4Gi
            cpu: 2
      networks:
        - name: default
          pod: {}
      volumes:
        - name: rootdisk
          persistentVolumeClaim:
            claimName: vm-root-disk
        - name: datadisk
          persistentVolumeClaim:
            claimName: vm-data-disk
        - name: cloudinitdisk
          cloudInitNoCloud:
            userData: |
              #cloud-config
              user: centos
              password: redhat123
              chpasswd: { expire: False }
              ssh_authorized_keys:
                - ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC... # Add your SSH key here
              runcmd:
                - echo "VM with persistent storage initialized" > /var/log/vm-init.log
                - mkdir -p /data
                - echo "Data directory created" >> /var/log/vm-init.log
EOF
Apply the VM configuration:

# Create the virtual machine
oc apply -f vm-with-persistent-storage.yaml

# Verify VM creation
oc get vm centos-vm-persistent

# Check VM details
oc describe vm centos-vm-persistent
Subtask 3.2: Start the Virtual Machine
Start the VM and verify it's running with persistent storage attached.

# Start the virtual machine
oc patch vm centos-vm-persistent --type merge -p '{"spec":{"running":true}}'

# Monitor VM startup
oc get vm centos-vm-persistent -w

# Check VMI (Virtual Machine Instance) status
oc get vmi centos-vm-persistent

# Get VM console access information
oc describe vmi centos-vm-persistent | grep -A 5 "Console Access"
Subtask 3.3: Verify Disk Attachment Inside VM
Connect to the VM and verify that all disks are properly attached.

# Get VM console access
virtctl console centos-vm-persistent

# Once inside the VM, check disk devices
lsblk

# Check disk partitions
fdisk -l

# Verify mount points
df -h

# Check for the data disk (should be unformatted)
ls -la /dev/vd*
Note: To exit the console, press Ctrl+]

Subtask 3.4: Format and Mount the Data Disk
Format the data disk and create a mount point for persistent data storage.

# Connect to VM console again
virtctl console centos-vm-persistent

# Format the data disk (assuming it's /dev/vdb)
sudo mkfs.ext4 /dev/vdb

# Create mount point
sudo mkdir -p /data

# Mount the data disk
sudo mount /dev/vdb /data

# Verify mount
df -h /data

# Create a test file
sudo touch /data/persistent-test-file.txt
echo "This file should persist across reboots" | sudo tee /data/persistent-test-file.txt

# Add to fstab for persistent mounting
echo "/dev/vdb /data ext4 defaults 0 2" | sudo tee -a /etc/fstab
Task 4: Verify Storage Performance and Resilience
Subtask 4.1: Test Storage Performance
Perform basic storage performance tests to verify disk I/O capabilities.

# Inside the VM console, test write performance
sudo dd if=/dev/zero of=/data/testfile bs=1M count=1024 oflag=direct

# Test read performance
sudo dd if=/data/testfile of=/dev/null bs=1M iflag=direct

# Remove test file
sudo rm /data/testfile

# Test random I/O performance (if fio is available)
sudo yum install -y fio

# Run a simple fio test
sudo fio --name=random-write --ioengine=libaio --rw=randwrite --bs=4k --size=1G --numjobs=1 --iodepth=1 --runtime=60 --time_based --directory=/data
Subtask 4.2: Test Data Persistence Across Reboots
Verify that data persists when the VM is stopped and restarted.

# Exit VM console
# Press Ctrl+] to exit console

# Stop the virtual machine
oc patch vm centos-vm-persistent --type merge -p '{"spec":{"running":false}}'

# Wait for VM to stop
oc get vm centos-vm-persistent -w

# Verify VM is stopped
oc get vmi centos-vm-persistent
Start the VM again and verify data persistence:

# Start the VM again
oc patch vm centos-vm-persistent --type merge -p '{"spec":{"running":true}}'

# Wait for VM to start
oc get vm centos-vm-persistent -w

# Connect to console
virtctl console centos-vm-persistent

# Check if data disk is mounted
df -h /data

# Verify our test file still exists
cat /data/persistent-test-file.txt

# Check system logs for mount information
sudo journalctl -u systemd-fsck@dev-disk-by\\x2duuid-* | tail -10
Subtask 4.3: Test Storage Resilience
Test storage resilience by simulating various failure scenarios.

# Inside VM, create additional test data
sudo mkdir -p /data/resilience-test
for i in {1..10}; do
  echo "Test file $i - $(date)" | sudo tee /data/resilience-test/file$i.txt
done

# List created files
ls -la /data/resilience-test/

# Exit console and simulate pod restart
# Press Ctrl+] to exit

# Delete the VMI to simulate a crash (VM spec will recreate it)
oc delete vmi centos-vm-persistent

# Monitor VM recreation
oc get vm centos-vm-persistent -w
oc get vmi centos-vm-persistent -w
Verify data after simulated failure:

# Once VM is running again, connect to console
virtctl console centos-vm-persistent

# Check if data survived the restart
ls -la /data/resilience-test/
cat /data/resilience-test/file1.txt

# Verify filesystem integrity
sudo fsck -n /dev/vdb
