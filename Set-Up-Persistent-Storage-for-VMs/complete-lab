Subtask 5.2: Configure Storage Snapshots
Create a volume snapshot for backup and recovery purposes.

# Create file: vm-storage-snapshot.yaml
cat << 'EOF' > vm-storage-snapshot.yaml
apiVersion: snapshot.storage.k8s.io/v1
kind: VolumeSnapshot
metadata:
  name: vm-data-snapshot
  namespace: vm-storage-lab
spec:
  volumeSnapshotClassName: ocs-storagecluster-rbdplugin-snapclass
  source:
    persistentVolumeClaimName: vm-data-disk
EOF
Create and verify the snapshot:

# Create the snapshot
oc apply -f vm-storage-snapshot.yaml

# Check snapshot status
oc get volumesnapshot vm-data-snapshot

# Get detailed snapshot information
oc describe volumesnapshot vm-data-snapshot

# List all snapshots
oc get volumesnapshot
