Task 1: Create Virtual Machines for Load Balancing
Subtask 1.1: Create the First Web Server VM
First, we'll create a VM that will serve as our web server backend.

Create a directory for lab files:
mkdir ~/lab13-loadbalancing
cd ~/lab13-loadbalancing
Create the first VM configuration file:
cat > webserver-vm1.yaml << 'EOF'
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: webserver-vm1
  namespace: default
  labels:
    app: webserver
    instance: vm1
spec:
  running: true
  template:
    metadata:
      labels:
        app: webserver
        instance: vm1
        kubevirt.io/vm: webserver-vm1
    spec:
      domain:
        cpu:
          cores: 1
        memory:
          guest: 1Gi
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
        resources:
          requests:
            memory: 1Gi
            cpu: 100m
      networks:
      - name: default
        pod: {}
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/fedora-cloud-container-disk-demo:latest
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            packages:
              - nginx
            runcmd:
              - systemctl enable nginx
              - systemctl start nginx
              - echo "<h1>Web Server VM1 - $(hostname)</h1><p>Server IP: $(hostname -I)</p>" > /var/www/html/index.html
              - systemctl restart nginx
EOF
Apply the VM configuration:
oc apply -f webserver-vm1.yaml
Wait for the VM to be ready:
oc wait --for=condition=Ready vm/webserver-vm1 --timeout=300s
