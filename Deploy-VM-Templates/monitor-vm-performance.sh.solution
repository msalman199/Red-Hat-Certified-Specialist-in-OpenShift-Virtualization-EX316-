#!/bin/bash
set -euo pipefail

NAMESPACE="vm-templates"

get_vm_resources() {
    local vm_name=$1
    echo "VM: $vm_name"

    if oc get vmi $vm_name -n $NAMESPACE >/dev/null 2>&1; then
        echo "  Node: $(oc get vmi $vm_name -n $NAMESPACE -o jsonpath='{.status.nodeName}')"
        echo "  Phase: $(oc get vmi $vm_name -n $NAMESPACE -o jsonpath='{.status.phase}')"

        local pod_name
        pod_name=$(oc get pods -n $NAMESPACE -l kubevirt.io/domain=$vm_name -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
        if [ -n "$pod_name" ]; then
            echo "  Pod: $pod_name"
            local usage
            usage=$(oc top pod $pod_name -n $NAMESPACE --no-headers 2>/dev/null || true)
            echo "  CPU Usage: $(echo "$usage" | awk '{print $2}')"
            echo "  Memory Usage: $(echo "$usage" | awk '{print $3}')"
        fi
    else
        echo "  Status: VMI not found or not running"
    fi
    echo
}

echo "=== VM Performance Monitoring ==="
echo

for vm in basic-vm-01 basic-vm-02 basic-vm-03 advanced-vm-01 postgres-vm-01; do
    get_vm_resources "$vm"
done
