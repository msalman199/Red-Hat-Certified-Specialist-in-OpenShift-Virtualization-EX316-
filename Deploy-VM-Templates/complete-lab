cat << 'EOF' > validate-template-deployment.sh.solution
#!/bin/bash
set -uo pipefail

NAMESPACE="vm-templates"
PASSED=0
FAILED=0

validate_vm() {
    local vm_name=$1
    local expected_template=$2

    echo "Validating VM: $vm_name"

    if ! oc get vm $vm_name -n $NAMESPACE >/dev/null 2>&1; then
        echo "  FAIL: VM does not exist"
        FAILED=$((FAILED+1))
        return
    fi

    local actual_template
    actual_template=$(oc get vm $vm_name -n $NAMESPACE -o jsonpath='{.metadata.labels.template}')
    if [ "$actual_template" = "$expected_template" ]; then
        echo "  PASS: Template label correct: $actual_template"
        PASSED=$((PASSED+1))
    else
        echo "  FAIL: Template label incorrect. Expected: $expected_template, Got: $actual_template"
        FAILED=$((FAILED+1))
    fi

    local status
    status=$(oc get vm $vm_name -n $NAMESPACE -o jsonpath='{.status.printableStatus}')
    if [ "$status" = "Running" ]; then
        echo "  PASS: VM is running"
        PASSED=$((PASSED+1))
    else
        echo "  FAIL: VM is not running. Status: $status"
        FAILED=$((FAILED+1))
    fi

    if [ "$status" = "Running" ]; then
        if oc get vmi $vm_name -n $NAMESPACE >/dev/null 2>&1; then
            echo "  PASS: VMI exists"
            PASSED=$((PASSED+1))
        else
            echo "  FAIL: VMI does not exist"
            FAILED=$((FAILED+1))
        fi
    fi

    echo
}

echo "=== Template Deployment Validation ==="
echo

validate_vm "basic-vm-01" "basic-vm"
validate_vm "basic-vm-02" "basic-vm"
validate_vm "basic-vm-03" "basic-vm"
validate_vm "advanced-vm-01" "advanced-vm"
validate_vm "postgres-vm-01" "database-vm"

echo "Validating Persistent Volume Claims:"
for pvc in advanced-vm-01-disk postgres-vm-01-db-disk postgres-vm-01-log-disk; do
    if oc get pvc $pvc -n $NAMESPACE >/dev/null 2>&1; then
        status=$(oc get pvc $pvc -n $NAMESPACE -o jsonpath='{.status.phase}')
        if [ "$status" = "Bound" ]; then
            echo "  PASS: PVC $pvc is bound"
            PASSED=$((PASSED+1))
        else
            echo "  FAIL: PVC $pvc is not bound. Status: $status"
            FAILED=$((FAILED+1))
        fi
    else
        echo "  FAIL: PVC $pvc does not exist"
        FAILED=$((FAILED+1))
    fi
done

echo
echo "=== Validation Summary ==="
echo "Passed: $PASSED"
echo "Failed: $FAILED"

if [ "$FAILED" -eq 0 ]; then
    echo "All validations passed."
    exit 0
else
    echo "Some validations failed. Review the output above."
    exit 1
fi
EOF
