Task 2: Deploy VMs Using These Templates
Subtask 2.1: Deploy VMs from the Basic Template
Generate an SSH key and deploy three basic VMs with different resource profiles.

# Generate SSH key pair for VM access (press Enter through prompts)
ssh-keygen -t rsa -b 4096 -f ~/.ssh/vm_key -N ""

# Get the public key content
VM_SSH_KEY=$(cat ~/.ssh/vm_key.pub)

# Deploy first basic VM
oc process basic-vm-template \
  -p VM_NAME=basic-vm-01 \
  -p NAMESPACE=vm-templates \
  -p CPU_CORES=2 \
  -p MEMORY=4Gi \
  -p SSH_PUBLIC_KEY="$VM_SSH_KEY" \
  | oc apply -f -

# Deploy second basic VM with more resources
oc process basic-vm-template \
  -p VM_NAME=basic-vm-02 \
  -p NAMESPACE=vm-templates \
  -p CPU_CORES=4 \
  -p MEMORY=8Gi \
  -p SSH_PUBLIC_KEY="$VM_SSH_KEY" \
  | oc apply -f -

# Deploy third basic VM with minimal resources
oc process basic-vm-template \
  -p VM_NAME=basic-vm-03 \
  -p NAMESPACE=vm-templates \
  -p CPU_CORES=1 \
  -p MEMORY=2Gi \
  -p SSH_PUBLIC_KEY="$VM_SSH_KEY" \
  | oc apply -f -
Subtask 2.2: Deploy the Advanced and Database VMs
# Deploy advanced VM with persistent storage
oc process advanced-vm-template \
  -p VM_NAME=advanced-vm-01 \
  -p NAMESPACE=vm-templates \
  -p CPU_CORES=4 \
  -p MEMORY=8Gi \
  -p STORAGE_SIZE=20Gi \
  -p ENVIRONMENT=production \
  -p SSH_PUBLIC_KEY="$VM_SSH_KEY" \
  | oc apply -f -

# Deploy database VM
oc process database-vm-template \
  -p VM_NAME=postgres-vm-01 \
  -p NAMESPACE=vm-templates \
  -p CPU_CORES=4 \
  -p MEMORY=8Gi \
  -p DB_STORAGE_SIZE=50Gi \
  -p LOG_STORAGE_SIZE=10Gi \
  -p SSH_PUBLIC_KEY="$VM_SSH_KEY" \
